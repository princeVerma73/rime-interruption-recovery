# Rime Voice AI Assistant Environment Variables (Template)
# Copy this file to backend/.env and replace placeholders with your actual API keys.

# Primary Spoken-Output Provider (Required for TTS)
RIME_API_KEY=your_rime_api_key_here

# LLM Providers (Required for Reasoning)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here 
# Needs latest/current info only 

# Optional Engine Configuration 
LLM_PROVIDER=groq
STT_PROVIDER=groq
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_STT_MODEL=whisper-large-v3

